views:
  - type: table
    name: Kanban
    filters:
      and:
        - file.ext == "md"
        - file.name.startsWith("QST-")
        - project == "questkit"
    groupBy:
      property: status
      direction: ASC
    order:
      - project
      - status
      - id
      - title
      - type
      - priority
      - effort
      - tier
      - modified
      - tags
      - milestone
    sort:
      - property: milestone
        direction: ASC
      - property: status
        direction: ASC
      - property: title
        direction: ASC
      - property: priority
        direction: ASC
      - property: type
        direction: ASC
      - property: project
        direction: ASC
  - type: table
    name: By priority
    filters:
      and:
        - file.ext == "md"
        - file.name.startsWith("QST-")
    order:
      - priority
      - id
      - title
      - status
      - type
      - project
    sort:
      - property: priority
        direction: ASC
      - property: title
        direction: ASC
      - property: priority
        direction: ASC
      - property: type
        direction: ASC
      - property: project
        direction: ASC
