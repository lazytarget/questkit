# Obsidian Bases view for this quest log. Bases is a fairly new Obsidian
# file format -- treat this as a starting point and adjust once opened.
views:
  - type: table
    name: Kanban
    filters:
      and:
        - file.ext == "md"
        - file.name.startsWith("QST-")
    groupBy:
      property: status
      direction: ASC
    order:
      - project
      - status
      - id
      - title
      - type
      - priority
      - effort
      - tier
      - modified
      - tags
    sort:
      - property: status
        direction: ASC
      - property: title
        direction: ASC
      - property: priority
        direction: ASC
      - property: type
        direction: ASC
      - property: project
        direction: ASC
  - type: table
    name: By priority
    filters:
      and:
        - file.ext == "md"
        - file.name.startsWith("QST-")
    order:
      - priority
      - id
      - title
      - status
      - type
      - project
    sort:
      - property: priority
        direction: ASC
      - property: title
        direction: ASC
      - property: priority
        direction: ASC
      - property: type
        direction: ASC
      - property: project
        direction: ASC
  - type: table
    name: Needs attention
    filters:
      and:
        - file.ext == "md"
        - file.name.startsWith("QST-")
        - status == "draft"
        - description == null
    order:
      - title
      - project
      - created
    sort:
      - property: created
        direction: ASC
